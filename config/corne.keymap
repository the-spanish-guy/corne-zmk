#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        // Layer-tap do Enter: toque digita, segurar ativa a layer 3.
        lt_fast: layer_tap_fast {
            compatible = "zmk,behavior-hold-tap";
            display-name = "LAYER_TAP_FAST";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            // Digitando rápido, vira toque na hora (sem atraso).
            require-prior-idle-ms = <150>;
            // Segurou e soltou sem apertar nada: ainda digita a tecla.
            retro-tap;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // layers = <0>: os combos só valem na layer base (como no QMK). Sem isso eles
        // também disparavam nas outras layers (por exemplo, "56" virava "(" nos números).

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 3>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_par {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <15 16>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_par {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
            layers = <0>;
            timeout-ms = <50>;
        };

        left_brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            layers = <0>;
            timeout-ms = <50>;
        };

        right_brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <32 31>;
            layers = <0>;
            timeout-ms = <50>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
            layers = <0>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q           &kp W           &kp E         &kp R             &kp T        &kp Y        &kp U         &kp I         &kp O            &kp P     &kp BSPC
&kp LCTRL  &kp A  &kp S  &kp D   &kp F  &kp G        &kp H        &kp J  &kp K   &kp L  &kp SEMI  &kp SQT
&kp LSHFT  &kp Z           &kp X           &kp C         &kp V             &kp B        &kp N        &kp M         &kp COMMA     &kp DOT          &kp FSLH  &kp ESC
                                           &kp LEFT_GUI  &mo 1             &kp SPACE  &lt_fast 3 ENTER  &mo 2        &kp LEFT_ALT
            >;
        };

        // Layer 1: números e setas
        lower_layer {
            bindings = <
&trans  &kp N1       &kp N2      &kp N3  &kp N4  &kp N5     &kp N6  &kp N7    &kp N8  &kp N9     &kp N0  &kp BSPC
&trans  &kp CAPS     &kp HOME    &kp END &trans  &kp F12    &kp LEFT &kp DOWN  &kp UP  &kp RIGHT  &trans  &trans
&trans  &ext_power EP_TOG  &kp DELETE  &trans  &trans  &trans     &trans  &trans    &trans  &trans     &trans  &trans
                                 &trans  &trans  &trans     &trans  &trans    &trans
            >;
        };

        // Layer 2: símbolos
        raise_layer {
            bindings = <
&trans  &kp EXCL     &kp AT      &kp HASH &kp DLLR &kp PRCNT  &kp CARET &kp AMPS   &kp STAR   &kp LPAR   &kp RPAR   &kp BSPC
&trans  &trans       &trans      &trans   &trans   &trans     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &kp GRAVE
&trans  &trans       &trans      &trans   &trans   &trans     &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC   &kp PIPE   &kp TILDE
                                 &trans   &trans   &trans     &trans     &trans     &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_CLR       &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&zone RGB_EFR  &rgb_matrix RGB_TOG  &zone RGB_EFF  &rgb_matrix RGB_BRI  &rgb_matrix RGB_BRD  &zone RGB_SPI  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &kp C_PREV       &kp C_PP         &kp C_NEXT       &kp C_VOL_DN     &kp C_VOL_UP     &trans  &trans  &trans  &trans   &trans   &trans
                                          &trans           &trans           &trans           &trans  &trans  &trans
            >;
        };

        extra1 { status = "reserved"; };

        extra2 { status = "reserved"; };

        extra3 { status = "reserved"; };

        extra4 { status = "reserved"; };
    };
};
